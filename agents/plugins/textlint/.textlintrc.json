{
  "filters": {
    "comments": true
  },
  "rules": {
    "preset-ja-technical-writing": {
      "sentence-length": {
        "max": 150
      },
      "no-mix-dearu-desumasu": {
        "preferInHeader": "",
        "preferInBody": "",
        "preferInList": "",
        "strict": false
      },
      "ja-no-mixed-period": {
        "allowPeriodMarks": [":", "："]
      },
      "max-kanji-continuous-len": {
        "max": 6,
        "allow": ["社会保険診療報酬支払基金", "診療報酬審査支払機構", "医療等情報利活用"]
      }
    },
    "prh": {
      "rulePaths": ["./prh.yml"]
    }
  }
}
