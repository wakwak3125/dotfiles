{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.local/share/mise/shims:$PATH\" node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs\" pre-write",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.local/share/mise/shims:$PATH\" node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs\" post-write",
            "timeout": 300
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.local/share/mise/shims:$PATH\" node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs\" post-bash",
            "timeout": 300
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.local/share/mise/shims:$PATH\" node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs\" subagent-stop",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
