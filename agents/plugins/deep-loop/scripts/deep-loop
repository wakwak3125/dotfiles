#!/usr/bin/env bash
# deep-loop の runner。サーバーで夜間に claude -p を切り離して走らせ、進み具合と成果物を見る。
#
#   deep-loop start <名前> [--repo <絶対パス>]... [--rounds <1-3>] [--at <HH:MM>]
#                   [--model <役>=<model>]... [--effort <役>=<effort>]... < brief.md
#     役は planner / worker / verifier / integrator / writer。指定しない役は deep-loop:run skill の既定に従う
#   deep-loop resume <名前> [--at <HH:MM>]
#   deep-loop status [<名前>]
#   deep-loop report <名前>
#   deep-loop stop <名前>
#
# 作業ディレクトリは ${DEEP_LOOP_ROOT:-~/.local/state/deep-loop}/<名前>。
# 開発中の plugin を試すときは DEEP_LOOP_PLUGIN_DIR に plugin のディレクトリを渡す（claude --plugin-dir に渡る）。
# 1 回の実行が使えるメモリは DEEP_LOOP_MEMORY_MAX（既定 16G、systemd の MemoryMax の書式）で絞る。

set -euo pipefail

# 相対パスのまま使うと、切り離した先の cd の後で作業ディレクトリを見失う
ROOT="$(realpath -m "${DEEP_LOOP_ROOT:-$HOME/.local/state/deep-loop}")"
MEMORY_MAX="${DEEP_LOOP_MEMORY_MAX:-16G}"

die() {
  echo "deep-loop: $*" >&2
  exit 1
}

usage() {
  sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
}

# 予約した実行が夜中に起動できずに終わるのを避けるため、上限を掛けられるかは受け付ける前に確かめる
require_memory_cap() {
  [[ "$MEMORY_MAX" =~ ^([0-9]+[KMGT]?|[0-9]+%|infinity)$ ]] ||
    die "DEEP_LOOP_MEMORY_MAX は 16G や 50% の形で書く（$MEMORY_MAX は読めない）"
  command -v systemd-run >/dev/null && systemctl --user show-environment >/dev/null 2>&1 ||
    die "systemd のユーザーセッションに繋がらないので、メモリの上限を掛けられない"
}

# 実行ごとの systemd の scope の名前。名前だけだと DEEP_LOOP_ROOT の違う実行（テストなど）と衝突するので、作業ディレクトリから決める
scope_unit() {
  echo "deep-loop-$(basename "$1")-$(printf '%s' "$1" | cksum | cut -d' ' -f1).scope"
}

check_name() {
  [[ "$1" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]] || die "名前 $1 は英小文字・数字・ハイフンで書く"
}

# プロセスの開始時刻（起動からの clock tick）。pid は再利用されるので、pid と組にして同じプロセスかを見分ける
start_time() {
  awk '{print $22}' "/proc/$1/stat" 2>/dev/null
}

# 走っているかは run.pid の pid と開始時刻で見る。pid だけだと、再利用された別のプロセスを走行中と見なし、
# stop がそのプロセスグループを殺す（試走で見つかった）
running() {
  local dir="$1" pid started
  [[ -f "$dir/run.pid" ]] || return 1
  read -r pid started <"$dir/run.pid" || return 1
  [[ -n "$pid" && -n "${started:-}" ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  [[ "$(start_time "$pid")" == "$started" ]] || return 1
  tr '\0' '\n' <"/proc/$pid/cmdline" 2>/dev/null | grep -qxF "$dir"
}

# --at の時刻までの秒数。HH:MM だけを受け、過ぎていれば翌日のその時刻にする
delay_until() {
  [[ "$1" =~ ^([01]?[0-9]|2[0-3]):[0-5][0-9]$ ]] || die "--at は HH:MM で書く（$1 は読めない）"
  local target now
  target="$(date -d "today $1" +%s)" || die "--at の時刻 $1 を読めない"
  now="$(date +%s)"
  ((target > now)) || target="$(date -d "tomorrow $1" +%s)"
  echo $((target - now))
}

meta_cwd() {
  python3 - "$1/meta.json" "$1" <<'PY' || die "meta.json を読めない: $1/meta.json"
import json, sys
repos = json.load(open(sys.argv[1])).get("repos", [])
print(repos[0] if repos else sys.argv[2])
PY
}

launch() {
  local dir="$1" delay="$2" cwd
  cwd="$(meta_cwd "$dir")"
  [[ -d "$cwd" ]] || die "作業を始めるディレクトリ $cwd が無い"
  local plugin_args=()
  if [[ -n "${DEEP_LOOP_PLUGIN_DIR:-}" ]]; then plugin_args=(--plugin-dir "$DEEP_LOOP_PLUGIN_DIR"); fi
  # 前回の実行の記録は消さずに退避する。再開の原因を後から追えるようにするため
  local stamp
  stamp="$(date +%Y%m%d-%H%M%S)"
  for file in session.json session.log; do
    if [[ -s "$dir/$file" ]]; then mv "$dir/$file" "$dir/$file.$stamp"; fi
  done
  # 背景の実行が即座に終わって exit_code を書いても消さないよう、起動より前に消す
  rm -f "$dir/exit_code"
  # 権限の確認に応じる人がいないので bypassPermissions で走らせる。作業役の書き込みは plugin の hook が作業ディレクトリに限る。
  # claude -p はバックグラウンドの作業（Workflow）を既定で 600 秒しか待たずに打ち切るので、上限を外す（実測）。
  # setsid で端末のセッションから切り離し、打った端末を閉じても止まらないようにする。
  # 作業役が並列に走らせた Gradle のテストが積み上がってホスト全体を OOM にし、無関係な常駐プロセスまで殺された（2026-10-01）。
  # claude を scope に入れて実行全体を MemoryMax で絞り、溢れたら実行の中だけで OOM kill させる。
  # swap を許すと上限を超えた分でホストの swap を食い潰すので、swap は使わせない。
  # Gradle が既存の daemon に繋ぐとビルドが scope の外で走るので、daemon は使わせない。
  # claude が終わっても、親を失った test worker が scope に残って何時間もメモリを握り続けた（実測）ので、最後に scope ごと止める。
  # exit_code はその後に書き、exit_code があれば後片付けまで済んでいるようにする
  DEEP_LOOP_DIR="$dir" CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0 \
    GRADLE_OPTS="${GRADLE_OPTS:+$GRADLE_OPTS }-Dorg.gradle.daemon=false" setsid bash -c '
    delay="$1"
    cwd="$2"
    dir="$3"
    unit="$4"
    memory_max="$5"
    shift 5
    sleep "$delay"
    # 予約の間にリポジトリが消えていたら、呼び出し元の cwd のまま bypassPermissions で走らせない
    if ! cd "$cwd"; then
      echo "deep-loop: $cwd に移れなかった" >"$dir/session.log"
      echo 1 >"$dir/exit_code"
      exit 1
    fi
    # 前回の実行の後片付けが漏れて scope が残っていると、同じ名前の scope を作れない
    systemctl --user stop "$unit" 2>/dev/null
    systemd-run --user --scope --quiet --unit="$unit" -p MemoryMax="$memory_max" -p MemorySwapMax=0 \
      claude -p --permission-mode bypassPermissions --output-format json "$@" "/deep-loop:run $dir" \
      >"$dir/session.json" 2>"$dir/session.log"
    code=$?
    systemctl --user stop "$unit" 2>/dev/null
    echo "$code" >"$dir/exit_code"
  ' deep-loop "$delay" "$cwd" "$dir" "$(scope_unit "$dir")" "$MEMORY_MAX" "${plugin_args[@]}" </dev/null >/dev/null 2>&1 &
  local pid=$!
  echo "$pid $(start_time "$pid")" >"$dir/run.pid"
}

parse_at() {
  # 値の無い --at を黙って読み飛ばすと、夜間に予約したつもりの実行が即座に始まる
  (($# >= 2)) && [[ -n "$2" ]] || die "--at に HH:MM を渡す"
  echo "$2"
}

cmd_start() {
  local name="$1"
  shift
  check_name "$name"
  local repos=() rounds=3 at="" overrides=()
  while (($# > 0)); do
    case "$1" in
      --repo)
        [[ "${2:-}" == /* ]] || die "--repo には絶対パスを渡す"
        [[ -d "$2" ]] || die "リポジトリ $2 が無い"
        repos+=("$2")
        shift 2
        ;;
      --rounds)
        [[ "${2:-}" =~ ^[1-3]$ ]] || die "--rounds は 1〜3"
        rounds="$2"
        shift 2
        ;;
      --at)
        at="$(parse_at "$@")"
        shift 2
        ;;
      --model | --effort)
        [[ "${2:-}" =~ ^(planner|worker|verifier|integrator|writer)=[a-z0-9.-]+$ ]] ||
          die "$1 は <役>=<値> で書く（役は planner / worker / verifier / integrator / writer）"
        overrides+=("${1#--}:$2")
        shift 2
        ;;
      *) die "未知の指定 $1" ;;
    esac
  done
  [[ -t 0 ]] && die "brief を標準入力で渡す（例: deep-loop start $name < brief.md）"
  require_memory_cap
  local delay=0
  if [[ -n "$at" ]]; then delay="$(delay_until "$at")"; fi
  # brief は一時ファイルに読んでから置く。空のまま作業ディレクトリを作ると、start も resume もできない名前が残る
  local brief
  brief="$(mktemp)"
  cat >"$brief"
  [[ -s "$brief" ]] || {
    rm -f "$brief"
    die "brief が空である"
  }
  mkdir -p "$ROOT"
  local dir="$ROOT/$name"
  # mkdir は既にあれば失敗するので、同じ名前の start が並んでも片方だけが通る
  mkdir "$dir" 2>/dev/null || {
    rm -f "$brief"
    die "$name はもうある。続けるなら deep-loop resume $name"
  }
  mkdir -p "$dir/rounds"
  mv "$brief" "$dir/brief.md"
  python3 - "$dir/meta.json" "$rounds" "${#repos[@]}" "${repos[@]}" "${overrides[@]}" <<'PY'
import json, sys
path, rounds, count, *rest = sys.argv[1:]
repos, overrides = rest[: int(count)], rest[int(count):]
meta = {"maxRounds": int(rounds), "repos": repos}
for item in overrides:
    kind, pair = item.split(":", 1)
    role, value = pair.split("=", 1)
    meta.setdefault("models" if kind == "model" else "efforts", {})[role] = value
json.dump(meta, open(path, "w"), ensure_ascii=False, indent=2)
PY
  launch "$dir" "$delay"
  echo "deep-loop: $name を始めた（$dir${at:+、$at に開始}）。進み具合は deep-loop status $name"
}

cmd_resume() {
  local name="$1" at=""
  shift
  check_name "$name"
  while (($# > 0)); do
    case "$1" in
      --at)
        at="$(parse_at "$@")"
        shift 2
        ;;
      *) die "未知の指定 $1" ;;
    esac
  done
  local dir="$ROOT/$name"
  [[ -s "$dir/brief.md" ]] || die "$name が無い（deep-loop start で始める）"
  running "$dir" && die "$name はもう走っている"
  require_memory_cap
  local delay=0
  if [[ -n "$at" ]]; then delay="$(delay_until "$at")"; fi
  launch "$dir" "$delay"
  echo "deep-loop: $name を再開した（${at:+$at に開始し、}完了したラウンドの続きから始める）"
}

summarize() {
  local dir="$1" name state rounds report
  name="$(basename "$dir")"
  state=停止
  running "$dir" && state=走行中
  rounds=0
  [[ -f "$dir/journal.jsonl" ]] && rounds="$(grep -c '"round"' "$dir/journal.jsonl" || true)"
  report=""
  [[ -s "$dir/report.md" ]] && report=成果物あり
  printf '%s\t%s\t%s ラウンド\t%s\n' "$name" "$state" "$rounds" "$report"
}

cmd_status() {
  if (($# == 0)); then
    [[ -d "$ROOT" ]] || return 0
    for dir in "$ROOT"/*/; do
      [[ -d "$dir" ]] && summarize "${dir%/}"
    done
    return 0
  fi
  check_name "$1"
  local dir="$ROOT/$1"
  [[ -d "$dir" ]] || die "$1 が無い"
  summarize "$dir"
  [[ -f "$dir/journal.jsonl" ]] && python3 - "$dir/journal.jsonl" <<'PY'
import json, sys
for number, line in enumerate(open(sys.argv[1]), 1):
    if not line.strip():
        continue
    try:
        e = json.loads(line)
    except ValueError:
        print(f"  （journal の {number} 行目を読めない）")
        continue
    if e.get("final"):
        print(f"  成果物: {e.get('summary', '')}")
        continue
    v = e.get("verdicts") or {}
    print(
        f"  r{int(e.get('round', 0)):02d} {e.get('status')}: 進展 {e.get('progress', '-')} / 未解決 {e.get('open_questions', '-')}"
        f" / 反証 確認{v.get('confirmed', 0)}・否定{v.get('refuted', 0)}・不明{v.get('uncertain', 0)}"
        f" / 失敗 {len(e.get('failed') or [])} — {e.get('summary', e.get('reason', ''))}"
    )
PY
  if [[ -f "$dir/exit_code" ]]; then
    echo "  終了コード: $(cat "$dir/exit_code")"
    [[ -s "$dir/session.json" ]] && python3 - "$dir/session.json" <<'PY' || true
import json, sys
try:
    print(f"  費用: {json.load(open(sys.argv[1])).get('total_cost_usd', 0):.2f} USD")
except ValueError:
    pass
PY
  fi
}

cmd_report() {
  check_name "$1"
  local dir="$ROOT/$1"
  [[ -s "$dir/report.md" ]] || die "成果物はまだ無い"
  cat "$dir/report.md"
}

cmd_stop() {
  check_name "$1"
  local dir="$ROOT/$1" pid
  running "$dir" || die "$1 は走っていない"
  read -r pid _ <"$dir/run.pid"
  # setsid で起こしたのでプロセスグループごと止める（claude と Workflow の子まで届く）
  kill -TERM -- "-$pid"
  # 起動役が後片付けの前に死ぬので、グループの外に出た子（Gradle の test worker など）は scope ごと止めて片づける
  systemctl --user stop "$(scope_unit "$dir")" 2>/dev/null || true
  echo "deep-loop: $1 を止めた。deep-loop resume $1 で完了したラウンドの続きから再開できる"
}

command="${1:-}"
shift || true
case "$command" in
  start)
    (($# >= 1)) || die "名前を渡す"
    cmd_start "$@"
    ;;
  resume)
    (($# >= 1)) || die "名前を渡す"
    cmd_resume "$@"
    ;;
  status) cmd_status "$@" ;;
  report)
    (($# == 1)) || die "名前を 1 つ渡す"
    cmd_report "$1"
    ;;
  stop)
    (($# == 1)) || die "名前を 1 つ渡す"
    cmd_stop "$1"
    ;;
  -h | --help | help | "") usage ;;
  *) die "未知のコマンド $command" ;;
esac
