{
  "filters": {
    "comments": true
  },
  "rules": {
    "preset-ja-technical-writing": {
      "sentence-length": {
        "max": 150
      },
      "no-mix-dearu-desumasu": {
        "preferInHeader": "",
        "preferInBody": "",
        "preferInList": "",
        "strict": false
      },
      "ja-no-mixed-period": {
        "allowPeriodMarks": [":", "："]
      }
    },
    "prh": {
      "rulePaths": ["./prh.yml"]
    }
  }
}
